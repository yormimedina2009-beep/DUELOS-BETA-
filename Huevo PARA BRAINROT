local KEY_FILE = "kiritto_key.txt"

local function leerKeyGuardada()
    if not (readfile and isfile) then return nil end
    local ok, contenido = pcall(function()
        if isfile(KEY_FILE) then return readfile(KEY_FILE) end
    end)
    if ok and contenido and #contenido > 0 then return contenido end
    return nil
end
local function guardarKey(key) if writefile then pcall(function() writefile(KEY_FILE, key) end) end end
local function borrarKeyGuardada()
    if delfile and isfile then pcall(function() if isfile(KEY_FILE) then delfile(KEY_FILE) end end) end
end

