    local function estaCaida(part)
        if not part or not part:IsA("BasePart") then return false end
        if part.AssemblyLinearVelocity.Magnitude > 2 then
            conTiempo[part] = 0
            ultPos[part] = part.Position
            return false
        end
        local pa = ultPos[part]
        local t = conTiempo[part] or 0
        if pa and (part.Position - pa).Magnitude > 0.5 then
            conTiempo[part] = 0
            ultPos[part] = part.Position
            return false
        end
        conTiempo[part] = t + 0.1
        ultPos[part] = part.Position
        if conTiempo[part] < CONFIG_FARM.tiempoEnSuelo then return false end
        return true
    end

    local function limpiar()
        local ahora = tick()
        for p, t in pairs(visitadas) do
            if ahora - t > CONFIG_FARM.tiempoMemoria then
