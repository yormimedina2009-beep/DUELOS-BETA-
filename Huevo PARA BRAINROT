    end

    local function buscar()
        local hrp = getHRP()
        if not hrp then return nil end
        local miPos = hrp.Position
        local mejor, mejorDist = nil, CONFIG_FARM.radio
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and esManzana(obj) and not obj:IsDescendantOf(LocalPlayer.Character) then
                if CONFIG_FARM.soloCaidas and not estaCaida(obj) then
                    statsFarm.ignoradas += 1
                elseif not visitadas[obj] then
                    local d = (obj.Position - miPos).Magnitude
                    if d < mejorDist then
                        mejorDist = d
                        mejor = obj
                    end
                end
            end
        end
        return mejor
    end

