local function crearTagRol(character, tipo)
    if not character or not tipo then return end
    local config = ROLE_TAGS[tipo]
    if not config then return end

    local head = character:WaitForChild("Head", 5)
    if not head then return end

    local anterior = head:FindFirstChild("KirittoRoleTag")
    if anterior then anterior:Destroy() end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KirittoRoleTag"
    billboard.Size = UDim2.fromOffset(150, 30)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 250
    billboard.ResetOnSpawn = false
    billboard.Parent = head

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Parent = billboard
    local cnr = Instance.new("UICorner"); cnr.CornerRadius = UDim.new(0, 8); cnr.Parent = frame

    local stk = Instance.new("UIStroke")
    stk.Color = config.color; stk.Thickness = 2
    stk.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stk.Parent = frame

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new(Color3.fromRGB(32,26,48), Color3.fromRGB(15,15,25))
    grad.Rotation = 90; grad.Parent = frame

    local barra = Instance.new("Frame")
    barra.Size = UDim2.new(0, 3, 1, -8)
    barra.Position = UDim2.new(0, 4, 0, 4)
    barra.BackgroundColor3 = config.color
    barra.BorderSizePixel = 0
    barra.Parent = frame
    local cb = Instance.new("UICorner"); cb.CornerRadius = UDim.new(0, 2); cb.Parent = barra

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = config.texto
    label.Font = Enum.Font.GothamBlack
    label.TextSize = 15
    label.TextColor3 = config.color
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.Parent = frame

    local gt = Instance.new("UIGradient")
    gt.Color = ColorSequence.new(config.color, config.color2)
    gt.Rotation = 20; gt.Parent = label

    local punto = Instance.new("Frame")
    punto.Size = UDim2.fromOffset(6, 6)
    punto.Position = UDim2.new(1, -10, 0.5, -3)
    punto.BackgroundColor3 = config.color
    punto.BorderSizePixel = 0
    punto.Parent = frame
    local cp = Instance.new("UICorner"); cp.CornerRadius = UDim.new(1, 0); cp.Parent = punto

    billboard.StudsOffset = Vector3.new(0, 5, 0)
    task.spawn(function()
        for i = 1, 22 do
            billboard.StudsOffset = Vector3.new(0, 5 - (i * 0.1), 0)
            task.wait(0.018)
        end
    end)

    task.spawn(function()
        while punto.Parent do
            TweenService:Create(punto, TweenInfo.new(0.8), {BackgroundTransparency = 0.7}):Play()
            task.wait(0.8)
            TweenService:Create(punto, TweenInfo.new(0.8), {BackgroundTransparency = 0}):Play()
            task.wait(0.8)
        end
    end)
end

