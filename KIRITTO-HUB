local EspTab = Window:CreateTab("ESP", 4483362458)

local chamsEnabled = false
local chamsColor = Color3.fromRGB(255, 0, 0)
local chamsTransparency = 0.5
local chamsOutline = true
local chamsTeamCheck = false
local chamsList = {}

EspTab:CreateToggle({Name = "ESP Chams", CurrentValue = false, Flag = "Chams",
    Callback = function(value)
        chamsEnabled = value
        if not value then
            for plr, hl in pairs(chamsList) do
                if hl then hl:Destroy() end
            end
            chamsList = {}
        end
    end})

EspTab:CreateToggle({Name = "Team Check (ignorar aliados)", CurrentValue = false, Flag = "ChamsTeam",
    Callback = function(value)
        chamsTeamCheck = value
        -- Re-aplicar
        for plr, hl in pairs(chamsList) do
            if hl then hl:Destroy() end
        end
        chamsList = {}
    end})

EspTab:CreateColorPicker({Name = "Color del Chams", Color = Color3.fromRGB(255, 0, 0),
    Flag = "ChamsColor",
    Callback = function(color)
        chamsColor = color
        for _, hl in pairs(chamsList) do
            if hl then hl.FillColor = color; hl.OutlineColor = color end
        end
    end})

EspTab:CreateSlider({Name = "Transparencia", Range = {0, 1}, Increment = 0.1,
    CurrentValue = 0.5, Flag = "ChamsTransp",
    Callback = function(value)
        chamsTransparency = value
        for _, hl in pairs(chamsList) do
            if hl then hl.FillTransparency = value end
        end
    end})

EspTab:CreateToggle({Name = "Mostrar contorno", CurrentValue = true, Flag = "ChamsOutline",
    Callback = function(value)
        chamsOutline = value
        for _, hl in pairs(chamsList) do
            if hl then hl.OutlineTransparency = value and 0 or 1 end
        end
    end})

local function applyChams()
    if not chamsEnabled then return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        if chamsTeamCheck and plr.Team and player.Team and plr.Team == player.Team then continue end
        local char = plr.Character
        if not char then continue end
        local hl = chamsList[plr]
        if not hl or not hl.Parent or hl.Adornee ~= char then
            if hl then hl:Destroy() end
            hl = Instance.new("Highlight")
            hl.Name = "KirittoChams"
            hl.FillColor = chamsColor
            hl.FillTransparency = chamsTransparency
            hl.OutlineColor = chamsColor
            hl.OutlineTransparency = chamsOutline and 0 or 1
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = char
            hl.Parent = plr
            chamsList[plr] = hl
        end
    end
end

task.spawn(function()
    while task.wait(0.3) do applyChams() end
end)

Players.PlayerRemoving:Connect(function(plr)
    if chamsList[plr] then
        chamsList[plr]:Destroy()
        chamsList[plr] = nil
    end
end)

