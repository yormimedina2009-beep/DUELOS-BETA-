local drawings = {}
local skeletonParts = {
    Head = {"Head"}, UpperTorso = {"UpperTorso"}, LowerTorso = {"LowerTorso"}, Torso = {"Torso"},
    LeftUpperArm = {"LeftUpperArm", "Left Arm"}, LeftLowerArm = {"LeftLowerArm", "Left Arm"}, LeftHand = {"LeftHand", "Left Arm"},
    RightUpperArm = {"RightUpperArm", "Right Arm"}, RightLowerArm = {"RightLowerArm", "Right Arm"}, RightHand = {"RightHand", "Right Arm"},
    LeftUpperLeg = {"LeftUpperLeg", "Left Leg"}, LeftLowerLeg = {"LeftLowerLeg", "Left Leg"}, LeftFoot = {"LeftFoot", "Left Leg"},
    RightUpperLeg = {"RightUpperLeg", "Right Leg"}, RightLowerLeg = {"RightLowerLeg", "Right Leg"}, RightFoot = {"RightFoot", "Right Leg"}
}
local skeletonConnections = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
}
local function getPart(character, name)
    local parts = skeletonParts[name]
    if not parts then return nil end
    for _, partName in pairs(parts) do
        local part = character:FindFirstChild(partName)
        if part then return part end
    end
    return nil
end

local function createESPForPlayer(plr)
    if plr == player then return end
    if drawings[plr] then return end
    local data = {}
    data.box = Drawing.new("Square")
    data.box.Thickness = 1; data.box.Filled = false; data.box.Transparency = 1; data.box.Visible = false
    data.corners = {}
    for i = 1, 8 do
        local line = Drawing.new("Line")
        line.Thickness = 2; line.Transparency = 1; line.Visible = false
        data.corners[i] = line
    end
    data.skeleton = {}
    for i = 1, #skeletonConnections do
        local line = Drawing.new("Line")
        line.Thickness = 1; line.Transparency = 1; line.Visible = false
        data.skeleton[i] = line
    end
    data.tracer = Drawing.new("Line")
    data.tracer.Thickness = 1; data.tracer.Transparency = 1; data.tracer.Visible = false
    data.headDot = Drawing.new("Circle")
    data.headDot.Radius = 4; data.headDot.Filled = true; data.headDot.Transparency = 1; data.headDot.Visible = false
    data.nameText = Drawing.new("Text")
    data.nameText.Size = 14; data.nameText.Center = true; data.nameText.Outline = true
    data.nameText.OutlineColor = Color3.fromRGB(0,0,0); data.nameText.Visible = false
    data.distText = Drawing.new("Text")
    data.distText.Size = 12; data.distText.Center = true; data.distText.Outline = true
    data.distText.OutlineColor = Color3.fromRGB(0,0,0); data.distText.Visible = false
    data.healthText = Drawing.new("Text")
    data.healthText.Size = 12; data.healthText.Center = true; data.healthText.Outline = true
    data.healthText.OutlineColor = Color3.fromRGB(0,0,0); data.healthText.Visible = false
    data.healthBarBG = Drawing.new("Square")
    data.healthBarBG.Thickness = 1; data.healthBarBG.Filled = true
    data.healthBarBG.Color = Color3.fromRGB(0,0,0); data.healthBarBG.Visible = false
    data.healthBarFill = Drawing.new("Square")
    data.healthBarFill.Thickness = 1; data.healthBarFill.Filled = true; data.healthBarFill.Visible = false
    local highlight = Instance.new("Highlight")
    highlight.Name = "KirittoESP"
    highlight.FillColor = chamsColor
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = chamsColor
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = nil
    highlight.Enabled = false
    highlight.Parent = plr
    data.highlight = highlight
    drawings[plr] = data
end

local function removeESPForPlayer(plr)
    if drawings[plr] then
        for _, drawing in pairs(drawings[plr]) do
            if typeof(drawing) == "table" then
                for _, sub in pairs(drawing) do
                    if sub.Remove then sub:Remove() end
                end
            elseif drawing.Remove then drawing:Remove()
            elseif drawing.Destroy then drawing:Destroy() end
        end
        drawings[plr] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do createESPForPlayer(plr) end
Players.PlayerAdded:Connect(createESPForPlayer)
Players.PlayerRemoving:Connect(removeESPForPlayer)

local function hideAll(data)
    data.box.Visible = false
    data.tracer.Visible = false
    data.headDot.Visible = false
    data.nameText.Visible = false
    data.distText.Visible = false
    data.healthText.Visible = false
    data.healthBarBG.Visible = false
    data.healthBarFill.Visible = false
    for _, line in pairs(data.corners) do line.Visible = false end
    for _, line in pairs(data.skeleton) do line.Visible = false end
    if data.highlight then data.highlight.Enabled = false end
end

RunService.RenderStepped:Connect(function()
    local myChar = player.Character
    local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") 
        and myChar.HumanoidRootPart.Position or Vector3.new(0,0,0)
    local inGameCheck = (not onlyInGame) or cachedInGame
    
    for plr, data in pairs(drawings) do
        if not espEnabled or not plr.Character or not inGameCheck then hideAll(data); continue end
        if teamCheck and plr.Team and player.Team and plr.Team == player.Team then hideAll(data); continue end
        
        local head = plr.Character:FindFirstChild("Head")
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
        if not head or not hrp or not humanoid or humanoid.Health <= 0 then hideAll(data); continue end
        
        local dist = (myPos - head.Position).Magnitude
        if dist > maxDistance then hideAll(data); continue end
        
        local headPos, headOnScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local hrpPos, hrpOnScreen = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        local onScreen = headOnScreen or hrpOnScreen
        
        if onScreen and showBox and not boxCorners then
            local h = math.abs(headPos.Y - hrpPos.Y)
            local w = h / 2
            data.box.Size = Vector2.new(w, h)
            data.box.Position = Vector2.new(headPos.X - w/2, headPos.Y)
            data.box.Color = boxColor
            data.box.Visible = true
        else data.box.Visible = false end
        
        if onScreen and boxCorners then
            local h = math.abs(headPos.Y - hrpPos.Y)
            local w = h / 2
            local x1 = headPos.X - w/2; local y1 = headPos.Y
            local x2 = headPos.X + w/2; local y2 = headPos.Y + h
            local cl = math.min(w, h) / 4
            local coords = {
                {Vector2.new(x1,y1), Vector2.new(x1+cl,y1)}, {Vector2.new(x1,y1), Vector2.new(x1,y1+cl)},
                {Vector2.new(x2,y1), Vector2.new(x2-cl,y1)}, {Vector2.new(x2,y1), Vector2.new(x2,y1+cl)},
                {Vector2.new(x1,y2), Vector2.new(x1+cl,y2)}, {Vector2.new(x1,y2), Vector2.new(x1,y2-cl)},
                {Vector2.new(x2,y2), Vector2.new(x2-cl,y2)}, {Vector2.new(x2,y2), Vector2.new(x2,y2-cl)}
            }
            for i, c in pairs(coords) do
                data.corners[i].From = c[1]; data.corners[i].To = c[2]
                data.corners[i].Color = cornerColor; data.corners[i].Visible = true
            end
        else for _, line in pairs(data.corners) do line.Visible = false end end
        
        if showSkeleton then
            for i, conn in pairs(skeletonConnections) do
                local p1 = getPart(plr.Character, conn[1])
                local p2 = getPart(plr.Character, conn[2])
                if p1 and p2 then
                    local s1, o1 = camera:WorldToViewportPoint(p1.Position)
                    local s2, o2 = camera:WorldToViewportPoint(p2.Position)
                    if o1 and o2 then
                        data.skeleton[i].From = Vector2.new(s1.X, s1.Y)
                        data.skeleton[i].To = Vector2.new(s2.X, s2.Y)
                        data.skeleton[i].Color = skeletonColor
                        data.skeleton[i].Visible = true
                    else data.skeleton[i].Visible = false end
                else data.skeleton[i].Visible = false end
            end
        else for _, line in pairs(data.skeleton) do line.Visible = false end end
        
        if onScreen and showTracer then
            data.tracer.From = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
            data.tracer.To = Vector2.new(headPos.X, headPos.Y)
            data.tracer.Color = tracerColor
            data.tracer.Visible = true
        else data.tracer.Visible = false end
        
        if onScreen and showHeadDot then
            data.headDot.Position = Vector2.new(headPos.X, headPos.Y)
            data.headDot.Color = headDotColor
            data.headDot.Visible = true
        else data.headDot.Visible = false end
        
        if onScreen and showName then
            data.nameText.Text = plr.Name
            data.nameText.Position = Vector2.new(headPos.X, headPos.Y - 40)
            data.nameText.Color = nameColor
            data.nameText.Visible = true
        else data.nameText.Visible = false end
        
        if onScreen and showDistance then
            data.distText.Text = "[" .. math.floor(dist) .. "m]"
            data.distText.Position = Vector2.new(headPos.X, headPos.Y - 25)
            data.distText.Color = distanceColor
            data.distTex.Visible = true
        else data.distText.Visible = false end
        
        if onScreen and showHealthPercent then
            local hp = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
            data.healthText.Text = hp .. "%"
            data.healthText.Position = Vector2.new(headPos.X, headPos.Y + 5)
            data.healthText.Color = healthBarColor
            data.healthText.Visible = true
        else data.healthText.Visible = false end
        
        if onScreen and showHealthBar and not showBox and not boxCorners then
            local h = math.abs(headPos.Y - hrpPos.Y)
            local barX = headPos.X - (h/4) - 6
            local barY = headPos.Y
            local hpRatio = humanoid.Health / humanoid.MaxHealth
            data.healthBarBG.Size = Vector2.new(3, h)
            data.healthBarBG.Position = Vector2.new(barX, barY)
            data.healthBarBG.Visible = true
            data.healthBarFill.Size = Vector2.new(3, h * hpRatio)
            data.healthBarFill.Position = Vector2.new(barX, barY + h * (1 - hpRatio))
            data.healthBarFill.Color = healthBarColor
            data.healthBarFill.Visible = true
        else
            data.healthBarBG.Visible = false
            data.healthBarFill.Visible = false
        end
        
        if showChams then
            data.highlight.Adornee = plr.Character
            data.highlight.FillColor = chamsColor
            data.highlight.OutlineColor = chamsColor
            data.highlight.Enabled = true
        else data.highlight.Enabled = false end
    end
end)

