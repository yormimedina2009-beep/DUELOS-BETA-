-- ============================================
AimTab:CreateSection("Auto-Shoot")

local autoShootEnabled = false
local autoShootDelay = 0.12
local predictionMultiplier = 1.0
local currentPing = 0.1

AimTab:CreateToggle({Name = "Auto-Shoot", CurrentValue = false, Flag = "AutoShoot",
    Callback = function(value) autoShootEnabled = value end})
AimTab:CreateSlider({Name = "Delay entre disparos", Range = {0.05, 0.5}, Increment = 0.01,
    Suffix = " seg", CurrentValue = 0.12, Flag = "AutoShootDelay",
    Callback = function(value) autoShootDelay = value end})
AimTab:CreateSlider({Name = "Multiplicador de predicción", Range = {0, 3}, Increment = 0.1,
    CurrentValue = 1.0, Flag = "PredictMult",
    Callback = function(value) predictionMultiplier = value end})

-- Leer ping real
task.spawn(function()
    while task.wait(1) do
        local ok, ping = pcall(function() return player:GetNetworkPing() end)
        if ok and ping and ping > 0 then currentPing = ping end
    end
end)

-- Posición predicha según ping
local function getPredictedPos()
    if not cachedTarget or not cachedTarget.Character then return nil end
    local targetPart = cachedTarget.Character:FindFirstChild(aimPart)
        or cachedTarget.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return nil end
    local pos = targetPart.Position
    local vel = targetPart.Velocity or Vector3.new(0, 0, 0)
    local predictTime = currentPing * predictionMultiplier
    local predicted = pos + (vel * predictTime)
    predicted = predicted + Vector3.new(0, 0.5 * 50 * predictTime * predictTime, 0)
    return predicted
end

RunService.RenderStepped:Connect(function()
    if (silentAimEnabled or autoShootEnabled) and cachedTarget then
        cachedTargetPos = getPredictedPos()
    end
end)

-- Loop Auto-Shoot
task.spawn(function()
    while task.wait(autoShootDelay) do
        if autoShootEnabled and cachedTarget and cachedTargetPos then
            local char = player.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
        end
    end
end)

