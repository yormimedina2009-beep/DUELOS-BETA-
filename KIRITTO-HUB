-- Lógica del Auto-Recoger
local function findCrystals()
    local crystals = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == "Crystal" and obj:IsA("BasePart") then
            table.insert(crystals, obj)
        end
    end
    return crystals
end

local function expandCrystal(touchPart)
    if not originals[touchPart] then
        originals[touchPart] = {
            size = touchPart.Size,
            transparency = touchPart.Transparency,
            color = touchPart.Color,
            material = touchPart.Material,
            canCollide = touchPart.CanCollide
        }
    end
    touchPart.Size = Vector3.new(collectRange, collectRange, collectRange)
    touchPart.Transparency = 1
    touchPart.CanCollide = false
    touchPart.Anchored = true
end

task.spawn(function()
    while task.wait(0.05) do
        if not autoCollectEnabled then continue end
        local char = player.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        
        local crystals = findCrystals()
        for _, crystal in pairs(crystals) do
            local parent = crystal.Parent
            if parent then
                local touch = parent:FindFirstChild("Touch")
                if touch then expandCrystal(touch) end
            end
        end
        
        if #crystals == 0 then continue end
        
        if moveTowards then
            table.sort(crystals, function(a, b)
                return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
            end)
            local target = crystals[1]
            if target then
                local dist = (target.Position - hrp.Position).Magnitude
                if dist > 5 then
                    local direction = (target.Position - hrp.Position).Unit
                    local moveDistance = math.min(moveSpeed * 0.05, dist)
                    hrp.CFrame = hrp.CFrame + direction * moveDistance
                end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(2) do
        for part in pairs(originals) do
            if not part.Parent then originals[part] = nil end
        end
    end
end)

