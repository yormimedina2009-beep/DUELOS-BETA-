    Callback = function(value) hitboxTransparency = value end})
AimTab:CreateColorPicker({Name = "Color del Hitbox", Color = Color3.fromRGB(255, 0, 0),
    Flag = "HitboxColor", Callback = function(color) hitboxColor = color end})

local function updateHitboxes()
    if not hitboxEnabled then
        for _, data in pairs(originalSizes) do
            if data.part and data.part.Parent then
                data.part.Size = data.size
                data.part.Transparency = data.transparency
                data.part.Color = data.color
                data.part.Material = data.material
            end
        end
        originalSizes = {}
        return
    end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        if aimTeamCheck and plr.Team == player.Team then continue end
        local char = plr.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if hrp then
            if not originalSizes[hrp] then
                originalSizes[hrp] = {part = hrp, size = hrp.Size, transparency = hrp.Transparency, color = hrp.Color, material = hrp.Material}
            end
            hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            hrp.CanCollide = false
            hrp.Transparency = hitboxTransparency
            hrp.Color = hitboxColor
            hrp.Material = Enum.Material.Neon
        end
        if head then
            if not originalSizes[head] then
                originalSizes[head] = {part = head, size = head.Size, transparency = head.Transparency, color = head.Color, material = head.Material}
            end
            head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            head.CanCollide = false
            head.Transparency = hitboxTransparency
            head.Color = hitboxColor
            head.Material = Enum.Material.Neon
        end
    end
end
RunService.Stepped:Connect(updateHitboxes)

-- BUSCAR TARGET
local function updateTarget()
    if not silentAimEnabled then
        cachedTarget = nil
        cachedTargetPos = nil
        return
    end
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local myChar = player.Character
    local closest = nil
    local closestPos = nil
    local shortestDist = aimFOV
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        if not char then continue end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        if aimTeamCheck and myChar and plr.Team == player.Team then continue end
        local targetPart = char:FindFirstChild(aimPart) or char:FindFirstChild("HumanoidRootPart")
        if not targetPart then continue end
        local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist > shortestDist then continue end
        if aimWallCheck and myChar then
            local myHead = myChar:FindFirstChild("Head")
            if myHead then
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {myChar, char}
                local result = workspace:Raycast(myHead.Position, targetPart.Position - myHead.Position, rayParams)
                if result then continue end
            end
        end
        shortestDist = dist
        closest = plr
        closestPos = targetPart.Position
    end
    cachedTarget = closest
    cachedTargetPos = closestPos
end
RunService.RenderStepped:Connect(updateTarget)

-- HOOK DEL MOUSE
local mouse = player:GetMouse()
local oldIndex
pcall(function()
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if self ~= mouse then return oldIndex(self, key) end
        if not cachedTargetPos then return oldIndex(self, key) end
        if key == "UnitRay" then
            local origin = camera.CFrame.Position
            local direction = (cachedTargetPos - origin).Unit
            return Ray.new(origin, direction)
        end
        if key == "Hit" then return CFrame.new(cachedTargetPos) end
        if key == "Target" then
            if cachedTarget and cachedTarget.Character then return cachedTarget.Character end
        end
        return oldIndex(self, key)
    end))
end)

-- HOOK DE ViewportPointToRay
local oldViewportPointToRay = camera.ViewportPointToRay
pcall(function()
    camera.ViewportPointToRay = newcclosure(function(self, x, y, ...)
        if cachedTargetPos then
            local origin = self.CFrame.Position
            local direction = (cachedTargetPos - origin).Unit
            return Ray.new(origin, direction)
        end
        return oldViewportPointToRay(self, x, y, ...)
    end)
end)

